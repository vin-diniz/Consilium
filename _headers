# Cloudflare Pages - cabecalhos HTTP de seguranca (VULN-003).
#
# Estado atual: CSP em Report-Only para nao quebrar o site enquanto
# inventariamos violacoes. Apos zero violacoes em todas as paginas-tipo
# (home, hub, local, sobre, privacidade) e no submit do form, trocar o
# nome do header de Content-Security-Policy-Report-Only para
# Content-Security-Policy (enforce).
#
# CSP rationale:
# - script-src 'self' https://challenges.cloudflare.com   - Turnstile
# - style-src 'self' 'unsafe-inline' fonts.googleapis.com - inline styles legitimos
# - font-src 'self' fonts.gstatic.com                     - Google Fonts
# - connect-src 'self'                                    - fetch /api/contact (same-origin)
# - frame-src challenges.cloudflare.com                   - iframe do Turnstile
# - frame-ancestors 'none' + X-Frame-Options DENY         - anti-clickjacking
# - form-action 'self'                                    - form submit so para o proprio host
# - img-src 'self' data: https:                           - flexivel para SVG/OG inline
# - object-src 'none' / base-uri 'self'                   - hardening padrao

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Long cache para assets imutaveis
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OG image (curto cache, pode ser regenerada)
/assets/og-image.jpg
  Cache-Control: public, max-age=604800

# Favicon longo cache
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
